# Local development only. In deployment add secrets in the HOSTING DASHBOARD.
# Never put provider credentials in NEXT_PUBLIC_* variables.
HYDE_INFERENCE_API_KEY=
LLM_BASE_URL=https://inference.hyde.tech/v1
LLM_MODEL=hyde/glm-5.3-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FINN_POLL_SECONDS=900
FINN_AUTO_REFRESH=true
FINN_DAILY_MODEL_CALL_LIMIT=60
# Optional local development only; production uses one origin and no CORS config.
FINN_CORS_ORIGINS=
# Keep empty for the single-container cloud deployment.
NEXT_PUBLIC_API_URL=
